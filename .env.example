# Copy to .env.local (gitignored) and fill in real values — never commit the real ones.
#
# EXPO_PUBLIC_FIREBASE_API_KEY: the Android-restricted Google Cloud API key for
# phone<->desktop sync (see utils/sync/firebaseConfig.ts). Get the current value from
# Google Cloud Console (APIs & Services > Credentials, project reminders-web-zs2026)
# or ask Zack.
EXPO_PUBLIC_FIREBASE_API_KEY=

# EXPO_PUBLIC_FIREBASE_ANDROID_CERT_SHA1: the SHA-1 fingerprint of whichever keystore
# signs the build you're running — the local debug keystore for `bun run dev`
# (`cd android && ./gradlew signingReport`, look under the "debug" variant), or the
# EAS-managed keystore for preview/production builds (`eas credentials`). This SHA-1
# must also be added, alongside the matching package name, to the API key's Android
# app restrictions in Google Cloud Console.
EXPO_PUBLIC_FIREBASE_ANDROID_CERT_SHA1=
